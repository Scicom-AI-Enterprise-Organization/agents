# OpenAI-compatible endpoints
LLM_URL=
LLM_URL_API=
LLM_MODEL=
STT_URL=
STT_URL_API=
STT_MODEL=
STT_LANGUAGE=en
TTS_URL=
TTS_URL_API=
TTS_MODEL=
TTS_SPEAKER=

# Semantic VAD, called at {EOT_URL}/predict. Leave blank for VAD-only turn detection.
EOT_URL=
EOT_URL_API=

# `livekit-server --dev`
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# false gives upstream behaviour, for comparison
COLLAPSE_USER_TURNS=true
